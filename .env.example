COMPANY_ID=rosesli
DB_HOST=localhost
DB_PORT=5432
DB_NAME=botdb
DB_USER=botuser
DB_PASS=
JWT_SECRET=replace-with-a-64-char-hex-string
FLASK_SECRET_KEY=replace-with-another-64-char-hex-string
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@rosesli.com
SMTP_PASS=your-app-password
